---
/**
 * PageHeader - Page title, description, and optional action slot
 */

interface Props {
  /** Page title */
  title: string;
  /** Optional description */
  description?: string;
}

const { title, description } = Astro.props;
---

<header class="mb-8 flex flex-wrap items-start justify-between gap-6">
  <div class="min-w-0 flex-1">
    <h1 class="m-0 font-(--font-display) text-4xl font-normal leading-tight text-(--color-text) sm:text-5xl">{title}</h1>
    {description && <p class="mt-3 m-0 max-w-3xl text-base leading-6 text-(--color-text-muted)">{description}</p>}
  </div>
  {Astro.slots.has('actions') && (
    <div class="flex flex-wrap items-center gap-3">
      <slot name="actions" />
    </div>
  )}
</header>
