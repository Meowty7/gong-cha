---
import { es } from '../lib/i18n/es';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: es.nav.dashboard, symbol: '▦' },
  { href: '/catalog', label: es.nav.catalog, symbol: '▤' },
  { href: '/inventory', label: es.nav.inventory, symbol: '◈' },
  { href: '/recipes', label: es.nav.recipes, symbol: '≡' },
  { href: '/calculations', label: es.nav.calculations, symbol: '∑' },
  { href: '/events', label: es.nav.events, symbol: '◫' },
  { href: '/production', label: es.nav.production, symbol: '⚙' },
];

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<nav class="flex min-h-full flex-col py-6" aria-label="Navegación principal">
  <div class="border-b border-(--color-border) px-6 pb-6">
    <h1 class="m-0 font-(--font-display) text-3xl font-normal">
      <a href="/" class="text-(--color-primary) no-underline transition hover:text-(--color-primary-dark)">
        Gong Cha
      </a>
    </h1>
  </div>
  
  <ul class="m-0 flex list-none flex-col gap-1 px-4 pt-6">
    {navItems.map((item) => (
      <li>
        <a 
          href={item.href}
          class:list={[
            'flex items-center gap-3 rounded-md px-4 py-3 text-[0.9375rem] font-medium no-underline transition',
            isActive(item.href)
              ? 'bg-(--color-primary) font-bold text-white hover:bg-(--color-primary-dark)'
              : 'text-(--color-text) hover:bg-(--color-bg-hover) hover:text-(--color-primary)',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="grid size-5 shrink-0 place-items-center text-base" aria-hidden="true">{item.symbol}</span>
          <span class="flex-1">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
