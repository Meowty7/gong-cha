---
import '../styles/global.css';
import AppSidebar from '../components/AppSidebar.astro';
import { es } from '../lib/i18n/es';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = es.app.name,
  description = es.dashboard.description 
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
  </head>
  
  <body class="min-h-screen bg-(--color-bg-warm) text-(--color-text)">
    <a href="#main-content" class="skip-link">
      {es.app.skipToMain}
    </a>
    
    <div class="grid min-h-screen grid-cols-1 md:grid-cols-[16rem_1fr] lg:grid-cols-[18rem_1fr]">
      <aside class="hidden h-screen overflow-y-auto border-r border-(--color-border) bg-(--color-bg-surface) md:sticky md:top-0 md:block">
        <AppSidebar />
      </aside>
      
      <details class="group sticky top-0 z-200 border-b border-(--color-border) bg-(--color-bg-surface) md:hidden">
        <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between px-4 font-(--font-display) text-2xl text-(--color-primary)">
          Gong Cha
          <span class="text-lg text-(--color-text-muted) transition group-open:rotate-180" aria-hidden="true">⌄</span>
        </summary>
        <div class="border-t border-(--color-border) px-2 pb-3">
          <AppSidebar />
        </div>
      </details>
      
      <main id="main-content" class="min-w-0 bg-(--color-bg-warm) px-4 py-6 sm:px-6 md:px-8 md:py-10 lg:px-10">
        <slot />
      </main>
    </div>
  </body>
</html>
