---
import AppLayout from '../layouts/AppLayout.astro';
import ApiStatus from '../components/ApiStatus.vue';
import { es } from '../lib/i18n/es';
---

<AppLayout title={es.dashboard.title} description={es.dashboard.description}>
  <div class="dashboard-container">
    <header class="page-header">
      <h1 class="page-title">{es.dashboard.title}</h1>
      <p class="page-description">{es.dashboard.description}</p>
    </header>
    
    <div class="dashboard-content">
      <section class="api-status-section">
        <h2 class="section-title sr-only">Estado de la API</h2>
        <ApiStatus client:load />
      </section>
      
      <section class="dashboard-placeholder">
        <div class="placeholder-card">
          <h2 class="placeholder-title">{es.dashboard.welcome}</h2>
          <p class="placeholder-text">{es.dashboard.placeholder}</p>
        </div>
      </section>
    </div>
  </div>
</AppLayout>

<style>
  .dashboard-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .page-header {
    margin-bottom: var(--space-8);
  }
  
  .page-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }
  
  .page-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }
  
  .dashboard-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  
  .section-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  
  .api-status-section {
    max-width: 42rem;
  }
  
  .dashboard-placeholder {
    margin-top: var(--space-6);
  }
  
  .placeholder-card {
    padding: var(--space-10) var(--space-6);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  
  .placeholder-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }
  
  .placeholder-text {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0 auto;
  }
  
  @media (min-width: 768px) {
    .page-title {
      font-size: 3rem;
    }
  }
</style>
