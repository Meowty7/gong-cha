---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CalculationsWorkspace from '../components/calculations/CalculationsWorkspace.vue';
import { es } from '../lib/i18n/es';
---

<AppLayout title={es.calculations.title} description={es.calculations.description}>
  <div class="page">
    <PageHeader title={es.calculations.title} description={es.calculations.description} />
    <CalculationsWorkspace client:load />
  </div>
</AppLayout>

<style>
.page {
  max-width: 1280px;
  margin: 0 auto;
}
</style>
