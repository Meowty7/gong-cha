---
import AppLayout from '../layouts/AppLayout.astro';
import ProductionPanel from '../components/production/ProductionPanel.vue';
import { es } from '../lib/i18n/es';
---

<AppLayout title={es.production.title} description={es.production.description}>
  <div class="mx-auto max-w-7xl">
    <header class="mb-8">
      <h1 class="text-4xl font-normal leading-tight text-(--color-text) sm:text-5xl">{es.production.title}</h1>
      <p class="mt-3 text-base leading-6 text-(--color-text-muted)">{es.production.description}</p>
    </header>
    <ProductionPanel client:load />
  </div>
</AppLayout>
