---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventPlanningWorkspace from '../components/events/EventPlanningWorkspace.vue';
import { es } from '../lib/i18n/es';
---

<AppLayout title={es.events.title} description={es.events.description}>
  <div class="page">
    <PageHeader title={es.events.title} description={es.events.description} />
    <EventPlanningWorkspace client:load />
  </div>
</AppLayout>

<style>
.page {
  max-width: 1280px;
  margin: 0 auto;
}
</style>
