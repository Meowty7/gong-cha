---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import RecipeWorkspace from '../components/recipes/RecipeWorkspace.vue';
import { es } from '../lib/i18n/es';

const title = `${es.recipes.title} — ${es.app.name}`;
---

<AppLayout title={title} description={es.recipes.description}>
  <div class="mx-auto max-w-7xl">
    <PageHeader title={es.recipes.title} description={es.recipes.description} />
    <RecipeWorkspace client:load />
  </div>
</AppLayout>
