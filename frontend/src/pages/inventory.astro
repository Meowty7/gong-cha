---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import InventoryWorkspace from '../components/InventoryWorkspace.vue';
import { es } from '../lib/i18n/es';

const title = `${es.inventory.title} — ${es.app.name}`;
---

<AppLayout title={title} description={es.inventory.description}>
  <div class="mx-auto max-w-7xl">
    <PageHeader title={es.inventory.title} description={es.inventory.description} />
    <InventoryWorkspace client:load />
  </div>
</AppLayout>
