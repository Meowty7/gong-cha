---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { es } from '../lib/i18n/es';

const title = `${es.inventory.title} — ${es.app.name}`;
---

<AppLayout title={title} description={es.inventory.description}>
  <PageHeader 
    title={es.inventory.title}
    description={es.inventory.description}
  />
  
  <div id="inventory-app"></div>
</AppLayout>

<script>
import { createApp } from 'vue';
import InventoryWorkspace from '../components/InventoryWorkspace.vue';

const app = createApp(InventoryWorkspace);
app.mount('#inventory-app');
</script>
