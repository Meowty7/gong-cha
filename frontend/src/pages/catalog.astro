---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CatalogWorkspace from '../components/CatalogWorkspace.vue';
import { es } from '../lib/i18n/es';

const title = `${es.catalog.title} — ${es.app.name}`;
---

<AppLayout title={title} description={es.catalog.description}>
  <div class="mx-auto max-w-7xl">
    <PageHeader title={es.catalog.title} description={es.catalog.description} />
    <CatalogWorkspace client:load />
  </div>
</AppLayout>
