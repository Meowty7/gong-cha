---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { es } from '../lib/i18n/es';

const title = `${es.catalog.title} — ${es.app.name}`;
---

<AppLayout title={title} description={es.catalog.description}>
  <PageHeader 
    title={es.catalog.title}
    description={es.catalog.description}
  />
  
  <div id="catalog-app"></div>
</AppLayout>

<script>
import { createApp } from 'vue';
import CatalogWorkspace from '../components/CatalogWorkspace.vue';

const app = createApp(CatalogWorkspace);
app.mount('#catalog-app');
</script>
