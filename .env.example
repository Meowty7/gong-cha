# Optional. `docker compose up --build` works without this file.

POSTGRES_USER=gongcha
POSTGRES_PASSWORD=gongcha
POSTGRES_DB=gongcha_cup

# Host port for the web UI (and /api via nginx). Default 80 → http://localhost
WEB_PORT=80

# Leave empty. Compose does not pass this into the web image.
# The browser must call /api on the same origin (nginx → API).
PUBLIC_API_URL=

CORS_ORIGIN=http://localhost,http://127.0.0.1
APP_ENV=development
